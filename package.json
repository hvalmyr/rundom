{
  "name": "rundom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "data:districts": "node scripts/build-districts.mjs",
    "data:build": "node --max-old-space-size=4096 scripts/data/build.mjs",
    "data:check": "node scripts/data/check.mjs public/data/stats.json",
    "data:fetch": "mkdir -p public/data && gh release download --repo hvalmyr/rundom --pattern data.tar.gz --output - | tar xz -C public/data"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.13.0"
  },
  "devDependencies": {
    "pbf": "^4.0.2",
    "vite": "^7.3.7"
  }
}
